<?xml version="1.0" encoding="utf-8"?>
<!--
    What the share sheet may read from this app: ONLY two folders inside the cache folder:
    shared-backups (BackupManager puts the backup zip there, and clears it at the next share and at
    start-up) and pdf (the PDF documents; older ones are deleted at each export and at start-up).
    The cache folder is never backed up by Android and nothing else is exposed.
-->
<paths>
    <cache-path name="shared_backups" path="shared-backups/" />
    <cache-path name="shared_pdf" path="pdf/" />
</paths>
